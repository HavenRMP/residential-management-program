# Pruebas de punta a punta (Playwright).
# Copia este archivo como .env.e2e (no se versiona) y llena las cuentas de PRUEBA del condominio Maderas.
# En CI estas mismas variables se definen como secretos del repositorio.

# URL de la web a probar. Vacío: levanta la app local en el puerto 4300.
E2E_BASE_URL=

# Usa el Chrome instalado en vez de descargar Chromium (valor: chrome). Vacío: Chromium de Playwright.
E2E_BROWSER_CHANNEL=

# Una cuenta por rol. Si falta alguna, los tests de ese rol se omiten (no fallan).
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_RESIDENTE_EMAIL=
E2E_RESIDENTE_PASSWORD=
E2E_VIGILANTE_EMAIL=
E2E_VIGILANTE_PASSWORD=
# Persona con acceso activo como sub-usuario de la vivienda del residente anterior
E2E_SUBUSUARIO_EMAIL=
E2E_SUBUSUARIO_PASSWORD=
